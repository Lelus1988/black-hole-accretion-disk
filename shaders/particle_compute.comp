#version 430 core

layout(local_size_x = 256) in;

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 properties;
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform float deltaTime;
uniform float blackHoleMass;
uniform float gravityStrength;
uniform float eventHorizonRadius;
uniform float spawnRadiusMin;
uniform float spawnRadiusMax;
uniform float diskThickness;
uniform uint particleCount;
uniform uint rngSeed;
uniform mat4 viewProjection;

uint hash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float randomValue(uint index) {
    return float(hash(index + rngSeed)) * (1.0 / 4294967295.0);
}

void respawn(inout Particle particle, uint index) {
    // Seed each particle from its index so parallel invocations don't share RNG state.
    float angle = randomValue(index * 5u) * 6.28318530718;
    float minRadiusSquared = spawnRadiusMin * spawnRadiusMin;
    float maxRadiusSquared = spawnRadiusMax * spawnRadiusMax;
    float radius = sqrt(mix(minRadiusSquared, maxRadiusSquared,
                            randomValue(index * 5u + 1u)));
    float speed = sqrt(gravityStrength * blackHoleMass / radius);
    float y = (randomValue(index * 5u + 2u) * 2.0 - 1.0) * diskThickness;

    particle.position = vec4(cos(angle) * radius, y, sin(angle) * radius, 1.0);
    particle.velocity = vec4(-sin(angle) * speed - cos(angle) * 0.02,
                             (randomValue(index * 5u + 3u) * 2.0 - 1.0) * 0.01,
                             cos(angle) * speed - sin(angle) * 0.02,
                             0.0);
    particle.properties = vec4(0.5 + randomValue(index * 5u + 4u), 0.0, 0.0, 1.0);
}

vec3 acceleration(vec3 position) {
    // Bound the force at the horizon to keep the integration stable near the center.
    float radiusSquared = max(dot(position, position), eventHorizonRadius * eventHorizonRadius);
    float inverseRadius = inversesqrt(radiusSquared);
    return -position * (gravityStrength * blackHoleMass * inverseRadius /
                        radiusSquared);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= particleCount) return;

    Particle particle = particles[index];
    vec3 position = particle.position.xyz;
    float radius = length(position);
    if (radius <= eventHorizonRadius) {
        respawn(particle, index);
        particles[index] = particle;
        return;
    }

    float stepTime = deltaTime;
    vec4 clipPosition = viewProjection * vec4(position, 1.0);
    bool outsideView = clipPosition.w <= 0.0 ||
                       abs(clipPosition.x) > clipPosition.w * 1.15 ||
                       abs(clipPosition.y) > clipPosition.w * 1.15 ||
                       clipPosition.z < -clipPosition.w ||
                       clipPosition.z > clipPosition.w;
    if (outsideView && radius > spawnRadiusMax * 1.4) {
        if (((index + rngSeed) & 3u) != 0u) return;
        stepTime *= 4.0;
    }

    // Velocity-Verlet is more stable for orbits than a single Euler step.
    vec3 oldAcceleration = acceleration(position);
    vec3 halfVelocity = particle.velocity.xyz + oldAcceleration * (0.5 * stepTime);
    position += halfVelocity * stepTime;
    vec3 newAcceleration = acceleration(position);
    vec3 velocity = halfVelocity + newAcceleration * (0.5 * stepTime);

    float newRadius = length(position);
    if (newRadius <= eventHorizonRadius) {
        respawn(particle, index);
    } else {
        float tangentDamping = max(0.0, 1.0 - stepTime * 0.0015);
        velocity.xz *= tangentDamping;
        particle.position = vec4(position, 1.0);
        particle.velocity = vec4(velocity, 0.0);
        particle.properties.y = clamp(1.0 - newRadius / (eventHorizonRadius * 9.0), 0.0, 1.0);
        particle.properties.z += stepTime;
    }

    particles[index] = particle;
}
